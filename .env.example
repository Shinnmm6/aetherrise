# ============================================================
# AetherRise Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Discord ──────────────────────────────────────────────
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id

# Optional: Leave blank for global commands (takes ~1 hour to register)
# Set to your server ID for instant registration during development
GUILD_ID=your_test_guild_id_here

# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string
# Local:   postgresql://user:password@localhost:5432/aetherrise
# Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Railway: automatically provided
DATABASE_URL=postgresql://postgres:password@localhost:5432/aetherrise

# ─── Redis ────────────────────────────────────────────────
# Used for cooldown caching (optional — falls back to in-memory)
# Local:   redis://localhost:6379
# Upstash: rediss://:[PASSWORD]@[HOST]:6380
REDIS_URL=redis://localhost:6379

# ─── Environment ──────────────────────────────────────────
NODE_ENV=development
